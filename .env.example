# Local PostgreSQL from docker-compose.yml. Replace for deployed environments.
DATABASE_URL="postgresql://kopilka:kopilka_dev@localhost:5432/kopilka?schema=public"

# Generate a unique value with at least 64 random characters for every environment.
SESSION_SECRET="replace-with-at-least-64-random-characters"
APP_ORIGIN="http://127.0.0.1:3000"

# Enable only when a trusted reverse proxy overwrites client forwarding headers.
TRUST_PROXY_HEADERS="false"

# Goal image storage. The local driver is development-only.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIRECTORY=".data/uploads"
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Optional Web Push. Core functionality must work when these values are empty.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
