# Public DNS name without a scheme. Its A/AAAA record must point to the VDS.
DOMAIN=kopilka.example.com
ACME_EMAIL=admin@example.com

# Use URL-safe values. scripts/deploy-vds.sh generates them automatically.
POSTGRES_DB=kopilka
POSTGRES_USER=kopilka
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
SESSION_SECRET=replace-with-at-least-64-random-characters

# A single VDS can safely use the persistent local volume below. Switch to s3
# before adding a second application replica.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIRECTORY=/app/data/uploads
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional Web Push. Leave empty until push notifications are configured.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
